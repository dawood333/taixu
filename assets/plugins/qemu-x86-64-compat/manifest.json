{
  "schemaVersion": 1,
  "id": "qemu-x86-64-compat",
  "name": "QEMU x86_64 User-Mode Compatibility Layer",
  "description": "Offline compatibility plugin containing only the ARM64 QEMU x86_64 user-mode emulator and a minimal x86_64 RootFS.",
  "dependencies": [],
  "launchType": "command",
  "version": "1.0.0",
  "latestVersion": "1.0.0",
  "enabled": true,
  "publisher": "TaiXu",
  "category": "DEVELOPER_TOOL",
  "architectures": ["ARM64"],
  "permissions": ["WORKSPACE_READ", "WORKSPACE_WRITE"],
  "updateStrategy": "REINSTALL",
  "source": "LOCAL",
  "offlineOnly": true,
  "installMethod": "LOCAL_PACKAGE",
  "installSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/install-qemu-x86-64-compat.sh\""
  ],
  "uninstallSteps": [
    "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/uninstall-qemu-x86-64-compat.sh\""
  ],
  "verifyCommand": "/bin/sh \"$TAIXU_PLUGIN_PAYLOAD/scripts/verify-qemu-x86-64-compat.sh\"",
  "launchCommand": "qemu-x86_64 --version",
  "commandLinks": ["qemu-x86_64"],
  "environment": {
    "TAIXU_QEMU_COMPAT_ROOT": "/opt/taixu/compat/x86_64",
    "TAIXU_QEMU_COMPAT_QEMU": "/opt/taixu/compat/x86_64/qemu-x86_64",
    "TAIXU_QEMU_COMPAT_ROOTFS": "/opt/taixu/compat/x86_64/rootfs"
  }
}
