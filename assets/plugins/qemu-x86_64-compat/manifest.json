{
  "schemaVersion": 1,
  "id": "qemu-x86-64-compat",
  "name": "QEMU x86_64 Compatibility Build Environment",
  "description": "Optional ARM64 QEMU user-mode emulation and an isolated x86_64 Linux RootFS for compatibility builds of third-party projects.",
  "version": "1.0.0",
  "publisher": "TaiXu",
  "category": "DEVELOPER_TOOL",
  "architectures": ["ARM64"],
  "permissions": ["WORKSPACE_READ", "WORKSPACE_WRITE"],
  "updateStrategy": "REINSTALL",
  "installMethod": "LOCAL_PACKAGE",
  "source": "LOCAL",
  "offlineOnly": true,
  "launchType": "command",
  "commandLinks": ["qemu-x86_64"],
  "environment": {
    "TAIXU_QEMU_COMPAT_ROOT": "/opt/taixu/compat/x86_64",
    "TAIXU_QEMU_COMPAT_QEMU": "/opt/taixu/compat/x86_64/qemu-x86_64",
    "TAIXU_QEMU_COMPAT_ROOTFS": "/opt/taixu/compat/x86_64/rootfs"
  }
}
